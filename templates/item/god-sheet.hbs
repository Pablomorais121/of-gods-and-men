<div class="god-sheet">
    <h1>{{item.name}}</h1>

    <fieldset>
        <legend>Description</legend>
        {{#if editable}}
            <textarea name="system.description">{{system.description}}</textarea>
        {{else}}
            <div class="readonly-text">{{{system.description}}}</div>
        {{/if}}
    </fieldset>

    <fieldset>
        <legend>Blessing</legend>

        <label>Name
            {{#if editable}}
                <input type="text" name="system.blessing.name" value="{{system.blessing.name}}">
            {{else}}
                <span>{{system.blessing.name}}</span>
            {{/if}}
        </label>

        <label>Cost (Stamina)
            {{#if editable}}
                <input type="number" name="system.blessing.cost" value="{{system.blessing.cost}}" min="0">
            {{else}}
                <span>{{system.blessing.cost}}</span>
            {{/if}}
        </label>

        <label>Description
            {{#if editable}}
                <textarea name="system.blessing.description">{{system.blessing.description}}</textarea>
            {{else}}
                <div class="readonly-text">{{{system.blessing.description}}}</div>
            {{/if}}
        </label>

        <label>Effect Type
            {{#if editable}}
                <select name="system.blessing.effectType">
                    <option value="none" {{#if (eq system.blessing.effectType "none")}}selected{{/if}}>None (narrative)</option>
                    <option value="single" {{#if (eq system.blessing.effectType "single")}}selected{{/if}}>Single Attribute/Skill</option>
                    <option value="allSkills" {{#if (eq system.blessing.effectType "allSkills")}}selected{{/if}}>All Skills</option>
                    <option value="allAttributes" {{#if (eq system.blessing.effectType "allAttributes")}}selected{{/if}}>All Attributes</option>
                </select>
            {{else}}
                <span>{{system.blessing.effectType}}</span>
            {{/if}}
        </label>
        {{#if (eq system.blessing.effectType "single")}}
            <label>Which 
                {{#if editable}}
                    <select name="system.blessing.effectKey">
                        <option value="">—</option>
                        <optgroup label="Attributes">
                            {{#each attributeOptions}}
                                <option value="attributes.{{this.key}}" {{#if (eq ../system.blessing.effectKey (concat "attributes." this.key))}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </optgroup>
                        <optgroup label="Skills">
                            {{#each skillOptions}}
                                <option value="skills.{{this.key}}" {{#if (eq ../system.blessing.effectKey (concat "skills." this.key))}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </optgroup>
                    </select>
                {{else}}
                    <span>{{system.blessing.effectKey}}</span>
                {{/if}}
            </label>   
        {{/if}}

        <label>Value
            {{#if editable}}
                <input type="number" name="system.blessing.effectValue" value="{{system.blessing.effectValue}}">
            {{else}}
                <span>{{system.blessing.effectValue}}</span>
            {{/if}}
        </label>
    </fieldset>

    <fieldset>
        <legend>Dogma</legend>
        
        <label>Name
            {{#if editable}}
                <input type="text" name="system.dogma.name" value="{{system.dogma.name}}">
            {{else}}
                <span>{{system.dogma.name}}</span>
            {{/if}}
        </label>
        
        <label>Description
            {{#if editable}}
                <textarea name="system.dogma.description">{{system.dogma.description}}</textarea>
            {{else}}
                <div class="readonly-text">{{{system.dogma.description}}}</div>
            {{/if}}
        </label>
    </fieldset>

    <fieldset>
        <legend>Spells</legend>
        {{#each system.spells}}
            <div class="spell-row">
                <label>Name
                    {{#if editable}}
                        <input type="text" class="spell-name" value="{{this.name}}">
                    {{else}}
                        <span>{{this.name}}</span>
                    {{/if}}
                </label>

                <label>Cost (Sanity)
                    {{#if editable}}
                        <input type="number" class="spell-cost" value="{{this.cost}}" min="0">
                    {{else}}
                        <span>{{this.cost}}</span>
                    {{/if}}
                </label>

                <label>Description
                    {{#if editable}}
                        <textarea class="spell-description">{{this.description}}</textarea>
                    {{else}}
                        <div class="readonly-text">{{{this.description}}}</div>
                    {{/if}}
                </label>

                <label>Effect Type
                    {{#if editable}}
                        <select class="spell-effect-type">
                            <option value="none" {{#if (eq this.effectType "none")}}selected{{/if}}>None</option>
                            <option value="single" {{#if (eq this.effectType "single")}}selected{{/if}}>Single</option>
                            <option value="allSkills" {{#if (eq this.effectType "allSkills")}}selected{{/if}}>All Skills</option>
                            <option value="allAttributes" {{#if (eq this.effectType "allAttributes")}}selected{{/if}}>All Attributes</option>
                        </select>
                    {{else}}
                        <span>{{this.effectType}}</span>
                    {{/if}}
                </label>
                {{#if (eq this.effectType "single")}}
                    <label>Which 
                        {{#if editable}}
                            <select class="spell-effect-key">
                                <option value="">—</option>
                                <optgroup label="Attributes">
                                    {{#each ../attributeOptions}}
                                        <option value="attributes.{{this.key}}" {{#if (eq ../this.effectKey (concat "attributes." this.key))}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </optgroup>
                                <optgroup label="Skills">
                                    {{#each ../skillOptions}}
                                        <option value="skills.{{this.key}}" {{#if (eq ../this.effectKey (concat "skills." this.key))}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </optgroup>
                            </select>
                        {{else}}
                            <span>{{this.effectKey}}</span>
                        {{/if}}
                    </label>   
                {{/if}}
                <label>Value
                    {{#if editable}}
                        <input type="number" class="spell-effect-value" value="{{this.effectValue}}">
                    {{else}}
                        <span>{{this.effectValue}}</span>
                    {{/if}}
                </label>
                {{#if editable}}
                    <button type="button" data-action="deleteSpell" data-index="{{@index}}">X</button>
                {{/if}}
            </div>
        {{/each}}
        {{#if editable}}
            <button type="button" data-action="addSpell">+ Add Spell</button>
            <button type="button" data-action="saveSpell">Save Spell</button>
        {{/if}}
    </fieldset>

</div>