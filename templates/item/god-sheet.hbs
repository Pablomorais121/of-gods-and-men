<div class="god-sheet">
    <h1>{{item.name}}</h1>

    <fieldset>
        <legend>Description</legend>
        <textarea name="system.description">{{system.description}}</textarea>
    </fieldset>

    <fieldset>
        <legend>Blessing</legend>
        <label>Name
            <input type="text" name="system.blessing.name" value="{{system.blessing.name}}">
        </label>

        <label>Cost (Stamina)
            <input type="number" name="system.blessing.cost" value="{{system.blessing.cost}}" min="0">
        </label>

        <label>Description
            <textarea name="system.blessing.description">{{system.blessing.description}}</textarea>
        </label>
        <label>Effect Attribute/Skill (e.g. attributes.strength)
            <input type="text" name="system.blessing.effectKey" value="{{system.blessing.effectKey}}">
        </label>
        <label>Effect Value
            <input type="number" name="system.blessing.effectValue" value="{{system.blessing.effectValue}}">
        </label>

    </fieldset>

    <fieldset>
        <legend>Dogma</legend>
        <label>Name
            <input type="text" name="system.dogma.name" value="{{system.dogma.name}}">
        </label>
        
        <label>Description
            <textarea name="system.dogma.description">{{system.dogma.description}}</textarea>
        </label>
    </fieldset>

    <fieldset>
        <legend>Spells</legend>
        {{#each system.spells}}
            <div class="spell-row">
                <label>Name
                    <input type="text" class="spell-name" value="{{this.name}}">
                </label>

                <label>Cost (Sanity)
                    <input type="number" class="spell-cost" value="{{this.cost}}" min="0">
                </label>

                <label>Description
                    <textarea class="spell-description">{{this.description}}</textarea>
                </label>

                <label>Effect Attribute/Skill
                    <input type="text" class="spell-effect-key" value="{{this.effectKey}}">
                </label>
                <label>Effect Value
                    <input type="number" class="spell-effect-value" value="{{this.effectValue}}">
                </label>
                    
                
                <button type="button" data-action="deleteSpell" data-index="{{@index}}">X</button>
            </div>
        {{/each}}

        <button type="button" data-action="addSpell">+ Add Spell</button>
        <button type="button" data-action="saveSpell">Save Spell</button>
    </fieldset>

</div>