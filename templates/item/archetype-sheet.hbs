<div class="archetype-sheet">
    <h1>{{item.name}}</h1>

    <fieldset>
        <legend>Description</legend>
        <textarea name="system.description">{{system.description}}</textarea>
    </fieldset>

    <fieldset>
        <legend>Priorities</legend>
        {{#each priorityRows}}
            <div class="priority-row">
                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                        class="score-dot {{#if this}}filled{{/if}}"
                        data-action="setPriorityPoints"
                        data-index="{{../index}}"
                        data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>

                <div class="priority-skills" data-index="{{this.index}}">
                    {{#each ../skillChoices}}
                        <label class="ogm-toggle ogm-toggle-sm">
                        <input type="checkbox" value="{{this.key}}" {{#if (includes ../this.options this.key)}}checked{{/if}}>
                        <span>{{this.label}}</span>
                        </label>
                    {{/each}}
                </div>
                
                <button type="button" data-action="deletePriority" data-index="{{this.index}}">✕</button>
            </div>
        {{/each}}
        <button type="button" data-action="addPriority">+ Add Priority</button>
    </fieldset>

</div>