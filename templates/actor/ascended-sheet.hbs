<div class="ascended-sheet">
    <h1>{{actor.name}}</h1>

    <fieldset>
        <legend>God</legend>
        {{#if god}}
            <p>{{god.name}}</p>
            <p><strong>{{god.system.blessing.name}}</strong> ({{god.system.blessing.cost}} Stamina)</p>
        {{else}}
            <p>Drag a God here</p>
        {{/if}}
    </fieldset>

    <fieldset>
        <legend>Archetype</legend>
        {{#if archetype}}
            <p>{{archetype.name}}</p>
        {{else}}
            <p>Drag an Archetype here</p>
        {{/if}}
    </fieldset>

    <fieldset>
        <legend>Resources</legend>

        <label>Health
            <input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}" min="0">
            / {{system.resources.health.max}}
        </label>

        <label>Stamina
            <input type="number" name="system.resources.stamina.value" value="{{system.resources.stamina.value}}" min="0">
            / {{system.resources.stamina.max}}
        </label>

        <label>Sanity
            <input type="number" name="system.resources.sanity.value" value="{{system.resources.sanity.value}}" min="0">
            / {{system.resources.sanity.max}}
        </label>
    </fieldset>

    <fieldset>
        <legend>Attributes</legend>

        {{#each attributeRows}}
            <div class="score-row">
                <span class="score-label">{{this.label}}</span>
                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="attributes"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

   <fieldset>
        <legend>Skills</legend>

        {{#each skillRows}}
            <div class="score-row">
                <span class="score-label">{{this.label}}</span>
                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="skills"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>Other</legend>

        <label>XP
            <input type="number" name="system.experience" value="{{system.experience}}" min="0">
        </label>

        <label>Divine Help Points
            <input type="number" name="system.divineHelpPoints" value="{{system.divineHelpPoints}}" min="0">
        </label>

        <label>Dogma Breaks
            <input type="number" name="system.dogmaBreaks" value="{{system.dogmaBreaks}}" min="0" max="3">
        </label>

    </fieldset>

</div>