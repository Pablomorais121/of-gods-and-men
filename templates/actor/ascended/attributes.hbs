<div class="tab {{tab.cssClass}}" data-tab="attributes" data-group="primary">
    <h1>{{actor.name}}</h1>
    
    <fieldset>
        <legend>God & Archetype</legend>
        <p>{{#if god}}{{god.name}}{{else}}No God chosen{{/if}} — {{#if archetype}}{{archetype.name}}{{else}}No Archetype chosen{{/if}}</p>
    </fieldset>

    <fieldset>
        <legend>Resources</legend>

        <div class="resource-cards">
            {{#each resourceBars}}
                <div class="resource-card">
                    <span class="resource-name">{{this.key}}</span>
                    <div class="resource-numbers">
                        <input type="number" name="system.resources.{{this.key}}.value" value="{{this.value}}" min="0">
                        <span>/ {{this.max}} </span>
                    </div>
                    <div class="resource-bar">
                        <div class="resource-bar-fill" style="width: {{this.pct}}%;"></div>
                    </div>
                </div>
            {{/each}}
        </div>
    </fieldset>

    <fieldset>
        <legend>Attributes</legend>

        {{#each attributeRows}}
            <div class="score-row">
                <span 
                    class="score-label" 
                    data-action="openRoll"
                    data-group="attributes"
                    data-key="{{this.key}}"
                >{{this.label}}</span>

                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="attributes"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

   <fieldset>
        <legend>Skills</legend>

        {{#each skillRows}}
            <div class="score-row">
                <span 
                class="score-label"
                data-action="openRoll"
                data-group="skills"
                data-key="{{this.key}}"
                >{{this.label}}</span>

                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="skills"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>Other</legend>

        <label>XP
            <input type="number" name="system.experience" value="{{system.experience}}" min="0">
        </label>

        <label>Divine Help Points
            <input type="number" name="system.divineHelpPoints" value="{{system.divineHelpPoints}}" min="0">
        </label>

        <div class="score-row">
            <span class="score-label">Dogma Breaks</span>
            <div class="score-dots">
                {{#each dogmaDots}}
                    <span
                        class="score-dot {{#if this}}filled{{/if}}"
                        data-action="setDogmaBreaks"
                        data-value="{{add @index 1}}"
                    ></span>
                {{/each}}
            </div>
        </div>

    </fieldset>
</div>