<div class="tab {{tab.cssClass}}" data-tab="attributes" data-group="primary">
    <h1>{{actor.name}}</h1>
    
    <fieldset>
        <legend>God & Archetype</legend>
        <p>{{#if god}}{{god.name}}{{else}}No God chosen{{/if}} — {{#if archetype}}{{archetype.name}}{{else}}No Archetype chosen{{/if}}</p>
    </fieldset>

    <fieldset>
        <legend>Resources</legend>

        <div class="resource-cards">
            {{#each resourceBars}}
                <div class="resource-card">
                    <span class="resource-name">{{this.key}}</span>
                    <div class="resource-numbers">
                        <input type="number" name="system.resources.{{this.key}}.value" value="{{this.value}}" min="0">
                        <span>/ {{this.max}} </span>
                    </div>
                    <div class="resource-bar">
                        <div class="resource-bar-fill" style="width: {{this.pct}}%;"></div>
                    </div>
                </div>
            {{/each}}
        </div>
    </fieldset>

    <fieldset>
        <legend>Attributes</legend>

        {{#each attributeRows}}
            <div class="score-row">
                <span 
                    class="score-label" 
                    data-action="openRoll"
                    data-group="attributes"
                    data-key="{{this.key}}"
                >{{this.label}}</span>

                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="attributes"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

   <fieldset>
        <legend>Skills</legend>

        {{#each skillRows}}
            <div class="score-row">
                <span 
                class="score-label"
                data-action="openRoll"
                data-group="skills"
                data-key="{{this.key}}"
                >{{this.label}}</span>

                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="skills"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>Other</legend>
        <div class="stat-cards">
            <div class="stat-card">
                <span class="resource-name">Experience</span>
                <div class="xp-numbers">
                    <div class="xp-field">
                        <label>Current</label>
                        <input type="number" name="system.experience.current" value="{{system.experience.current}}" min="0">
                    </div>
                    <div class="xp-field">
                        <label>Total</label>
                        <input type="number" name="system.experience.total" value="{{system.experience.total}}" min="0">
                    </div>
                </div>
            </div>

            <div class="stat-card">
                <span class="resource-name">Divine Help</span>
                <input type="number" name="system.divineHelpPoints" value="{{system.divineHelpPoints}}" min="0" class="stat-single-input">
            </div>

            <div class="stat-card">
                <span class="resource-name">Dogma Breaks</span>
                <div class="score-dots score-dots-center">
                    {{#each dogmaDots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setDogmaBreaks"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        </div>
    </fieldset>
</div>