<div class="npc-sheet">
    <h1>{{actor.name}}</h1>    
    
     <fieldset>
        <label>Tier
            <input type="number" name="system.tier" value="{{system.tier}}" min="0" max="10">
        </label>

    </fieldset>

    <fieldset>
        <legend>Resources</legend>

        <div class="resource-cards">
            {{#each resourceBars}}
                <div class="resource-card">
                    <span class="resource-name">{{this.key}}</span>
                    <div class="resource-numbers">
                        <input type="number" name="system.resources.{{this.key}}.value" value="{{this.value}}" min="0">
                        <span>/ {{this.max}} </span>
                    </div>
                    <div class="resource-bar">
                        <div class="resource-bar-fill" style="width: {{this.pct}}%;"></div>
                    </div>
                </div>
            {{/each}}
        </div>
    </fieldset>

    <fieldset>
        <legend>Attributes</legend>

        {{#each attributeRows}}
            <div class="score-row">
                <span 
                    class="score-label" 
                    data-action="openRoll"
                    data-group="attributes"
                    data-key="{{this.key}}"
                >{{this.label}}</span>

                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="attributes"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

   <fieldset>
        <legend>Skills</legend>

        {{#each skillRows}}
            <div class="score-row">
                <span 
                class="score-label"
                data-action="openRoll"
                data-group="skills"
                data-key="{{this.key}}"
                >{{this.label}}</span>
                
                <div class="score-dots">
                    {{#each this.dots}}
                        <span
                            class="score-dot {{#if this}}filled{{/if}}"
                            data-action="setScore"
                            data-group="skills"
                            data-key="{{../key}}"
                            data-value="{{add @index 1}}"
                        ></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </fieldset>

</div>